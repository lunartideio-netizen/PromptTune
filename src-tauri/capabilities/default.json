{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for PromptTune desktop application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "*://*/*" },
        { "url": "*://*:*/*" },
        { "url": "*://*" },
        { "url": "*://*:*" },
        { "url": "http://*/*" },
        { "url": "http://*:*/*" },
        { "url": "https://*/*" },
        { "url": "https://*:*/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
